# ============================================
# Database Configuration
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=studio_user
DB_PASSWORD=studio_password
DB_DATABASE=studio_db
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ============================================
# Meshy API Configuration
# ============================================
# Obtén tu API key en: https://www.meshy.ai/api
MESHY_API_KEY=your_meshy_api_key_here
MESHY_API_BASE_URL=https://api.meshy.ai
MESHY_API_TIMEOUT=30000

# ============================================
# Meshy Application Configuration
# ============================================
# Tipo de modelo por defecto: 'standard' o 'premium'
MESHY_DEFAULT_MODEL_TYPE=standard
# Polígonos por defecto (rango: 1000-50000)
MESHY_DEFAULT_POLYCOUNT=10000
MESHY_MAX_POLYCOUNT=50000
MESHY_MIN_POLYCOUNT=1000

# ============================================
# Meshy Task Configuration
# ============================================
# Intervalo de polling para verificar estado (ms)
MESHY_POLLING_INTERVAL=5000
# Número máximo de reintentos en caso de error
MESHY_MAX_RETRIES=3

# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# Notas
# ============================================
# 1. Copia este archivo a .env y completa los valores
# 2. DB_SYNCHRONIZE=true solo para desarrollo (crea/actualiza tablas automáticamente)
# 3. DB_LOGGING=true para ver las queries SQL en consola (útil para desarrollo)
# 4. NODE_ENV puede ser: development, production, test
